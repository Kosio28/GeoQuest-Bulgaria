# Optional project URL and browser-safe Supabase publishable key (sb_publishable_…).
# Never put a service_role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Mapillary client access token from https://www.mapillary.com/dashboard/developers
# This client token is visible in the browser. Never use a client secret here.
VITE_MAPILLARY_ACCESS_TOKEN=your_client_access_token_here


